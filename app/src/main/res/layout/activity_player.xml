<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:show_fastforward_button="true"
        app:show_rewind_button="true"
        app:show_shuffle_button="false"
        app:show_subtitle_button="true"
        app:show_vr_button="false" />

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlc_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/vlc_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B8000000"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/vlc_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/vlc_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/player_feedback_background"
                    android:fontFamily="@font/jost_medium"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Pause"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/vlc_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/jost_medium"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="/"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/vlc_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jost_medium"
                    android:text="00:00"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/vlc_audio_tracks"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/player_feedback_background"
                    android:fontFamily="@font/jost_medium"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Audio"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/vlc_subtitle_tracks"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/player_feedback_background"
                    android:fontFamily="@font/jost_medium"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Subtitles"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <com.miracle.kglaynyi.player.PlayerQualityButton
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/player_feedback_background"
                    android:fontFamily="@font/jost_medium"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Quality"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <com.miracle.kglaynyi.player.SubtitleSizeButton
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/player_feedback_background"
                    android:fontFamily="@font/jost_medium"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <com.miracle.kglaynyi.player.MxViewModeButton
                    android:id="@+id/video_view_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/player_feedback_background"
                    android:fontFamily="@font/jost_medium"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Fit"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/exo_safe_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.miracle.kglaynyi.player.MxViewModeButton
            android:id="@+id/exo_view_mode"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/player_feedback_background"
            android:fontFamily="@font/jost_medium"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Fit"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <com.miracle.kglaynyi.player.PlayerQualityButton
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/player_feedback_background"
            android:fontFamily="@font/jost_medium"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Quality"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <com.miracle.kglaynyi.player.SubtitleSizeButton
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/player_feedback_background"
            android:fontFamily="@font/jost_medium"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>

    <Button
        android:id="@+id/player_settings_button"
        android:layout_width="48dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/player_feedback_background"
        android:fontFamily="@font/jost_bold"
        android:minWidth="0dp"
        android:text="⋮"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <FrameLayout
        android:id="@+id/player_settings_panel"
        android:layout_width="56%"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#EE080A08"
        android:elevation="24dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="18dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/tab_video"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:fontFamily="@font/jost_medium"
                        android:text="VIDEO"
                        android:textAllCaps="false"
                        android:textColor="@color/download_button_bg_color"
                        android:textSize="17sp" />

                    <Button
                        android:id="@+id/tab_audio"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:fontFamily="@font/jost_medium"
                        android:text="AUDIO"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                    <Button
                        android:id="@+id/tab_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:fontFamily="@font/jost_medium"
                        android:text="SUBTITLE"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/video_settings_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/jost_regular"
                        android:text="Aspect Ratio"
                        android:textColor="#CCFFFFFF"
                        android:textSize="16sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/aspect_default"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@color/transparent"
                                android:text="Default"
                                android:textAllCaps="false"
                                android:textColor="@color/download_button_bg_color"
                                android:textSize="16sp" />

                            <Button
                                android:id="@+id/aspect_stretch"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@color/transparent"
                                android:text="Stretch"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <Button
                                android:id="@+id/aspect_fill"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@color/transparent"
                                android:text="Filling"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <Button
                                android:id="@+id/aspect_16_9"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@color/transparent"
                                android:text="16:9"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <Button
                                android:id="@+id/aspect_4_3"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@color/transparent"
                                android:text="4:3"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/jost_regular"
                            android:text="Auto Skip Intro &amp; End Time"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/auto_skip_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/jost_regular"
                        android:text="Custom Skip Intro Time"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/intro_skip_value"
                            android:layout_width="110dp"
                            android:layout_height="48dp"
                            android:background="@drawable/player_feedback_background"
                            android:fontFamily="@font/jost_medium"
                            android:gravity="center"
                            android:text="00:00"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/intro_skip_minus"
                            android:layout_width="64dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/player_feedback_background"
                            android:text="−"
                            android:textColor="@color/white"
                            android:textSize="24sp" />

                        <Button
                            android:id="@+id/intro_skip_plus"
                            android:layout_width="64dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/player_feedback_background"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/jost_regular"
                        android:text="Custom Skip End Time"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/end_skip_value"
                            android:layout_width="110dp"
                            android:layout_height="48dp"
                            android:background="@drawable/player_feedback_background"
                            android:fontFamily="@font/jost_medium"
                            android:gravity="center"
                            android:text="00:00"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/end_skip_minus"
                            android:layout_width="64dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/player_feedback_background"
                            android:text="−"
                            android:textColor="@color/white"
                            android:textSize="24sp" />

                        <Button
                            android:id="@+id/end_skip_plus"
                            android:layout_width="64dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/player_feedback_background"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/playback_speed_button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/player_feedback_background"
                        android:fontFamily="@font/jost_medium"
                        android:text="Playback Speed • 1.0x"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <com.miracle.kglaynyi.player.PlayerQualityButton
                        android:id="@+id/panel_quality_button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/player_feedback_background"
                        android:fontFamily="@font/jost_medium"
                        android:text="Source / Quality"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/audio_settings_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/jost_regular"
                        android:text="Choose an audio track for this video."
                        android:textColor="#CCFFFFFF"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/panel_audio_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/player_feedback_background"
                        android:fontFamily="@font/jost_medium"
                        android:text="Audio Tracks"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/subtitle_settings_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/jost_regular"
                        android:text="Choose subtitle track and subtitle size."
                        android:textColor="#CCFFFFFF"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/panel_subtitle_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/player_feedback_background"
                        android:fontFamily="@font/jost_medium"
                        android:text="Subtitle Tracks"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <com.miracle.kglaynyi.player.SubtitleSizeButton
                        android:id="@+id/panel_subtitle_size"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/player_feedback_background"
                        android:fontFamily="@font/jost_medium"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <TextView
        android:id="@+id/gesture_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_feedback_background"
        android:fontFamily="@font/jost_medium"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/decoder_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/player_feedback_background"
        android:fontFamily="@font/jost_medium"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Software decoder"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
