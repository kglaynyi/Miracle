<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F3"
    android:orientation="vertical"
    android:paddingTop="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <ProgressBar
            android:id="@+id/homeScanSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeScanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/jost_regular"
            android:text="Scanning file source"
            android:textColor="#4A4A4A"
            android:textSize="12sp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/homeSearchButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Search"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            android:tint="#202020" />

        <TextView
            android:id="@+id/homeMoreButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="⋯"
            android:textColor="#202020"
            android:textSize="28sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="82dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/continueWatchingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jost_medium"
                    android:text="Resume Playback"
                    android:textColor="#242424"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/continueWatchingViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jost_regular"
                    android:text="View All  ›"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/continueWatchingRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/recentlyAdded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jost_medium"
                    android:text="Recently Added"
                    android:textColor="#242424"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/recentlyAddedViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jost_regular"
                    android:text="View All  ›"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentlyAddedRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/topRatedMovies"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jost_medium"
                    android:text="Movies"
                    android:textColor="#242424"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/moviesViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jost_regular"
                    android:text="View All  ›"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/topRatedMoviesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/newReleasesMovies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/jost_medium"
                android:text="New Releases"
                android:textColor="#242424"
                android:textSize="17sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentlyReleasedMoviesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/lastPlayedMovies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/jost_medium"
                android:text="Last Played"
                android:textColor="#242424"
                android:textSize="17sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lastPlayedMoviesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/watchListMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/jost_medium"
                android:text="Watchlist"
                android:textColor="#242424"
                android:textSize="17sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/watchListMediaRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/newSeason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/jost_medium"
                android:text="TV Shows"
                android:textColor="#242424"
                android:textSize="17sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/newSeasonRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/topRatedTVShows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/jost_medium"
                android:text="Top Rated Shows"
                android:textColor="#242424"
                android:textSize="17sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/topRatedTVShowsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
